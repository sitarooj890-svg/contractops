# ContractOps — example env. Copy to .env and fill locally. Never commit .env.
# Inside Docker, backend must use host "db" (service name in docker-compose.yml).

POSTGRES_USER=contractops
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=contractops
# db:5432 — "db" is the compose service name, do NOT use localhost here
DATABASE_URL=postgresql+psycopg://contractops:change-me-locally@db:5432/contractops

BACKEND_PORT=8000
JWT_SECRET=change-me